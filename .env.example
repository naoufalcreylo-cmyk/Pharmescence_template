# Meta Marketing API credentials.
#
# Copy this file to `.env` for local development. `.env` is gitignored and must
# NEVER be committed — this repository is public, and a leaked ad-account token
# is picked up by automated scanners within minutes.
#
# In production these are set in Vercel: Project -> Settings -> Environment
# Variables. Vercel reads them at deploy time, so after adding or changing one
# you must redeploy for it to take effect.

# Numeric ad account ID from Ads Manager. The act_ prefix is added if you omit it.
META_AD_ACCOUNT_ID=act_123456789

# System User token with the ads_read scope ONLY.
# ads_read is read-only: if this token ever leaked, it could expose your numbers
# but could not spend money or change campaigns. Do not grant ads_management.
META_ACCESS_TOKEN=

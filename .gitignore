# Dependencies — reinstalled from package-lock.json, never committed
node_modules/

# Build output — regenerated by the deploy workflow on every push
dist/
dist-ssr/
*.local

# Secrets. If you later add a Meta API access token, it goes in a .env file
# and that file must never reach GitHub.
.env
.env.*
!.env.example

# Editor / OS noise
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.swp

# Local tool state
.claude/settings.local.json
.vite/
npm-debug.log*
yarn-error.log*
